{
  "expo": {
    "name": "Daybook",
    "slug": "daybook-journal",
    "version": "1.0.0",
    "icon": "./assets/daybook-icon.png",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.daybook.journal",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#356B5B",
        "foregroundImage": "./assets/daybook-icon.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Daybook to record private voice entries."
        }
      ],
      "expo-notifications",
      "expo-status-bar",
      "expo-font",
      "expo-asset",
      "expo-sqlite",
      "expo-sharing",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Daybook to add selected photos to private journal entries.",
          "cameraPermission": false
        }
      ],
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F2EB",
          "image": "./assets/daybook-splash.png",
          "imageWidth": 132,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#151A17",
            "image": "./assets/daybook-splash.png"
          }
        }
      ]
    ]
  }
}
